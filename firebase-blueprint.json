        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "profYear", "batch", "groupLabel", "wardName", "department",
        "supervisorName", "startDate", "endDate", "status", "sessionsLogged",
        "notes", "institutionId", "staffUids", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/UserProfile" }, "description": "User RBAC profiles with permissions & auto-generated access code." },
    "/users/{userId}/private/{docId}": { "schema": { "$ref": "#/entities/UserPrivateInfo" }, "description": "Isolated PII." },
    "/accessInvites/{inviteId}": { "schema": { "$ref": "#/entities/AccessInvite" }, "description": "Pre-authorized institutional email invites with permissions & access code." },
    "/masterConfig/{configId}": { "schema": { "$ref": "#/entities/MasterConfig" }, "description": "Master lists for attendance options, session types, activities, prof years, departments, and Smart Hub settings." },
    "/teachers/{teacherId}": { "schema": { "$ref": "#/entities/TeacherProfile" }, "description": "BAMS faculty directory." },
    "/subjects/{subjectId}": { "schema": { "$ref": "#/entities/Subject" }, "description": "BAMS curriculum subjects." },
    "/students/{studentId}": { "schema": { "$ref": "#/entities/StudentRecord" }, "description": "BAMS student attendance standings." },
    "/attendanceSessions/{sessionId}": { "schema": { "$ref": "#/entities/AttendanceSession" }, "description": "Class sessions with topic, activity, entryMode, QR/Geo flags, draft and submitted states." },
    "/attendanceSessions/{sessionId}/records/{studentId}": { "schema": { "$ref": "#/entities/SessionStudentRecord" }, "description": "Per-student hourly session entries." },
    "/attendanceSessions/{sessionId}/checkIns/{uid}": { "schema": { "$ref": "#/entities/StudentCheckIn" }, "description": "Student self check-ins." },
    "/alerts/{alertId}": { "schema": { "$ref": "#/entities/AttendanceAlert" }, "description": "Absenteeism and compliance alerts." },
    "/interactionLogs/{logId}": { "schema": { "$ref": "#/entities/InteractionLog" }, "description": "Real-time interaction & audit logs." },
    "/learningResources/{resourceId}": { "schema": { "$ref": "#/entities/LearningResource" }, "description": "Learning repository: notes, test papers, marks, notifications." },
    "/feedbackItems/{feedbackId}": { "schema": { "$ref": "#/entities/FeedbackItem" }, "description": "Portal feedback & continuous improvement items." },
    "/leaveRequests/{leaveId}": { "schema": { "$ref": "#/entities/LeaveRequest" }, "description": "Medical & Duty leave condonation requests." },
    "/clinicalRotations/{rotationId}": { "schema": { "$ref": "#/entities/ClinicalRotation" }, "description": "Hospital OPD/IPD posting rotations for clinical batches." }
  }
